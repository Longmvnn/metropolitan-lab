# Authorize the Gmail account archplazalab@gmail.com for gmail.send.
# Never commit real values. Hosted runtime values belong in the host's secrets settings.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
REMINDER_JOB_SECRET=
# For the standalone reminder worker only:
LAB_URL=http://127.0.0.1:5173

# Simplest way to send email: a Gmail App Password for archplazalab@gmail.com
# (Google Account > Security > 2-Step Verification > App passwords). Paste the 16 characters here.
GMAIL_APP_PASSWORD=
# Optional: the Gmail account the App Password belongs to (defaults to archplazalab@gmail.com).
GMAIL_ADDRESS=
